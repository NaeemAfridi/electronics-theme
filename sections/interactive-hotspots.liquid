{% comment %}
  Renders an interactive product feature hotspot diagram for electronics products.
{% endcomment %}

<div class="interactive-hotspots-section py-12 md:py-16 bg-surface text-foreground" style="background-color: {{ section.settings.bg_override | default: 'var(--color-surface)' }}">
  <div class="max-w-[var(--page-width)] mx-auto px-4 md:px-6">
    
    {% if section.settings.heading != blank or section.settings.subheading != blank %}
      <div class="text-center max-w-2xl mx-auto mb-10 md:mb-14">
        {% if section.settings.subheading != blank %}
          <span class="text-xs uppercase tracking-widest text-accent font-bold mb-2 block">
            {{ section.settings.subheading }}
          </span>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-foreground">
            {{ section.settings.heading }}
          </h2>
        {% endif %}
      </div>
    {% endif %}

    <div class="relative w-full max-w-4xl mx-auto rounded-card overflow-hidden border border-border bg-background shadow-2xl">
      {% if section.settings.image != blank %}
        {{ section.settings.image | image_url: width: 1600 | image_tag: class: 'w-full h-auto object-cover block', loading: 'lazy', alt: section.settings.heading }}
      {% else %}
        <div class="w-full aspect-[16/9] bg-slate-900 flex items-center justify-center text-muted border border-dashed border-border">
          <span>Select high-resolution electronics product image in Theme Editor</span>
        </div>
      {% endif %}

      {% comment %} Hotspot Pins Layer {% endcomment %}
      {% for block in section.blocks %}
        <div
          class="hotspot-pin-wrapper absolute -translate-x-1/2 -translate-y-1/2 group"
          style="top: {{ block.settings.top_position }}%; left: {{ block.settings.left_position }}%;"
          {{ block.shopify_attributes }}
        >
          {% comment %} Pulsing Marker Button {% endcomment %}
          <button
            type="button"
            class="hotspot-trigger relative flex items-center justify-center w-8 h-8 rounded-full bg-accent text-white font-bold text-xs shadow-lg focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 transition-transform hover:scale-110"
            aria-label="{{ block.settings.title }}"
          >
            <span class="absolute inset-0 rounded-full bg-accent animate-ping opacity-75"></span>
            <span class="relative z-10">{{ block.settings.badge | default: forloop.index }}</span>
          </button>

          {% comment %} Popover Card {% endcomment %}
          <div class="hotspot-popover absolute z-30 hidden group-hover:block group-focus-within:block w-64 md:w-72 p-4 bg-slate-950/95 backdrop-blur-md border border-border rounded-card shadow-2xl text-left left-1/2 -translate-x-1/2 bottom-full mb-3 pointer-events-auto transition-all">
            {% if block.settings.title != blank %}
              <h4 class="text-base font-bold text-foreground mb-1 flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-accent inline-block"></span>
                {{ block.settings.title }}
              </h4>
            {% endif %}
            {% if block.settings.description != blank %}
              <p class="text-xs text-muted leading-relaxed">
                {{ block.settings.description }}
              </p>
            {% endif %}
            {% comment %} Pointer Arrow {% endcomment %}
            <div class="absolute left-1/2 -translate-x-1/2 top-full w-0 h-0 border-x-8 border-x-transparent border-t-8 border-t-slate-950"></div>
          </div>
        </div>
      {% endfor %}

    </div>

  </div>
</div>

{% schema %}
{
  "name": "Tech Feature Hotspots",
  "tag": "section",
  "class": "electronics-hotspots-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Precision Engineering Inside"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading / Tagline",
      "default": "Hardware Specifications"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Exploded / Internal Product Image"
    },
    {
      "type": "color",
      "id": "bg_override",
      "label": "Custom Background Color"
    }
  ],
  "blocks": [
    {
      "type": "hotspot",
      "name": "Feature Hotspot Pin",
      "limit": 8,
      "settings": [
        {
          "type": "range",
          "id": "top_position",
          "min": 5,
          "max": 95,
          "step": 1,
          "unit": "%",
          "label": "Top Position (Y-Axis)",
          "default": 50
        },
        {
          "type": "range",
          "id": "left_position",
          "min": 5,
          "max": 95,
          "step": 1,
          "unit": "%",
          "label": "Left Position (X-Axis)",
          "default": 50
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Pin Number / Label",
          "default": "01"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Feature Title",
          "default": "40mm Titanium Driver"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Feature Description",
          "default": "Custom acoustic chamber engineered for distortion-free bass and sub-10ms response."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tech Feature Hotspots",
      "blocks": [
        {
          "type": "hotspot",
          "settings": {
            "top_position": 35,
            "left_position": 40,
            "badge": "01",
            "title": "Acoustic Drivers",
            "description": "40mm titanium diaphragm calibrated for studio audio clarity."
          }
        },
        {
          "type": "hotspot",
          "settings": {
            "top_position": 65,
            "left_position": 70,
            "badge": "02",
            "title": "Active ANC Chipset",
            "description": "Dual quad-core DSP chips processing 40,000 noise samples per second."
          }
        }
      ]
    }
  ]
}
{% endschema %}
