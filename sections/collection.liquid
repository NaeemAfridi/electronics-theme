{% comment %}
  Electronics Collection & Catalog Section
{% endcomment %}

{% liquid
  assign target_collection = section.settings.collection | default: collection
  if target_collection == blank or target_collection.products == blank
    assign target_collection = collections.all
  endif

  assign limit = section.settings.products_to_show | default: 12
%}

<div class="collection-page-section py-8 md:py-12 bg-background text-foreground">
  <div class="max-w-[var(--page-width)] mx-auto px-4 md:px-6">
    
    {% comment %} Collection Banner Header {% endcomment %}
    <div class="mb-8 pb-6 border-b border-border flex flex-col md:flex-row md:items-end justify-between gap-4">
      <div>
        <span class="text-xs uppercase tracking-widest text-accent font-bold mb-1 block">Catalog</span>
        <h1 class="text-3xl md:text-4xl font-bold tracking-tight text-foreground">
          {{ target_collection.title | default: 'Featured Electronics' }}
        </h1>
        {% if target_collection.description != blank %}
          <p class="text-sm text-muted mt-2 max-w-2xl leading-relaxed">
            {{ target_collection.description }}
          </p>
        {% endif %}
      </div>

      <div class="text-xs text-muted font-semibold bg-surface border border-border px-4 py-2 rounded-lg self-start md:self-auto">
        Showing {{ target_collection.products_count | default: 0 }} Products
      </div>
    </div>

    {% comment %} Faceted Filters & Sorting Control Bar (Only on Collection Template Page) {% endcomment %}
    {% if template.name == 'collection' and target_collection.filters.size > 0 %}
      <div class="mb-8 p-4 bg-surface border border-border rounded-card flex flex-wrap items-center justify-between gap-4">
        
        {% comment %} Filter Pills / Summary {% endcomment %}
        <div class="flex items-center gap-2 overflow-x-auto">
          <span class="text-xs font-bold text-muted uppercase tracking-wider">Filters:</span>
          {% for filter in target_collection.filters %}
            {% if filter.type == 'price_range' %}
              {% if filter.min_value.value or filter.max_value.value %}
                <span class="inline-flex items-center gap-1 text-xs px-2.5 py-1 bg-accent/10 text-accent border border-accent/30 rounded-full font-medium">
                  Price: {{ filter.min_value.value | default: 0 | money }} - {{ filter.max_value.value | default: filter.range_max | money }}
                </span>
              {% endif %}
            {% else %}
              {% for value in filter.active_values %}
                <span class="inline-flex items-center gap-1 text-xs px-2.5 py-1 bg-accent/10 text-accent border border-accent/30 rounded-full font-medium">
                  {{ filter.label }}: {{ value.label }}
                </span>
              {% endfor %}
            {% endif %}
          {% endfor %}
        </div>

        {% comment %} Sort By Selector {% endcomment %}
        <div class="flex items-center gap-2">
          <label for="SortBy" class="text-xs font-bold text-muted uppercase tracking-wider">Sort:</label>
          <select
            id="SortBy"
            name="sort_by"
            class="bg-background border border-border text-foreground text-xs font-medium rounded-button px-3 py-2 focus:outline-none focus:ring-1 focus:ring-accent"
            onchange="location.href = '?sort_by=' + this.value"
          >
            {% for option in target_collection.sort_options %}
              <option value="{{ option.value }}" {% if option.value == target_collection.sort_by %}selected="selected"{% endif %}>
                {{ option.name }}
              </option>
            {% endfor %}
          </select>
        </div>

      </div>
    {% endif %}

    {% comment %} Products Grid Routing {% endcomment %}
    {% if template.name == 'collection' %}
      {% comment %} Paginated Loop on Collection Page Route {% endcomment %}
      {% paginate target_collection.products by limit %}
        {% if target_collection.products.size > 0 %}
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
            {% for product in target_collection.products %}
              {% render 'product-card', product: product %}
            {% endfor %}
          </div>

          <div class="mt-12 flex justify-center">
            {{ paginate | default_pagination }}
          </div>
        {% else %}
          <div class="py-16 text-center text-muted">
            <p class="text-lg font-bold text-foreground">No products found in this collection.</p>
          </div>
        {% endif %}
      {% endpaginate %}
    {% else %}
      {% comment %} Non-Paginated Loop on Homepage or Other Templates {% endcomment %}
      {% if target_collection.products.size > 0 %}
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
          {% for product in target_collection.products limit: limit %}
            {% render 'product-card', product: product %}
          {% endfor %}
        </div>
      {% else %}
        <div class="py-16 text-center text-muted">
          <p class="text-lg font-bold text-foreground">No products found in this collection.</p>
        </div>
      {% endif %}
    {% endif %}

  </div>
</div>

{% schema %}
{
  "name": "Electronics Collection",
  "tag": "section",
  "class": "electronics-collection-section",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 24,
      "step": 4,
      "default": 8,
      "label": "Number of products to show"
    }
  ],
  "presets": [
    {
      "name": "Electronics Collection"
    }
  ]
}
{% endschema %}
