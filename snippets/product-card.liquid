{% doc %}
  Renders an Electronics product card.

  @param {product} product - The product object to render
{% enddoc %}

<div class="group bg-surface/60 border border-border hover:border-accent/50 rounded-card p-4 flex flex-col justify-between transition-all hover:shadow-2xl h-full">
  <div>
    {% comment %} Product Image Container {% endcomment %}
    <a href="{{ product.url }}" class="block relative w-full aspect-square bg-background border border-border rounded-lg overflow-hidden mb-4">
      {% if product.featured_image != blank %}
        {{ product.featured_image | image_url: width: 600 | image_tag: class: 'w-full h-full object-contain p-2 group-hover:scale-105 transition-transform duration-300', loading: 'lazy', alt: product.title }}
      {% else %}
        <div class="w-full h-full flex items-center justify-center text-muted text-xs">No Image</div>
      {% endif %}

      {% if product.available == false %}
        <span class="absolute top-2 left-2 px-2 py-0.5 text-[10px] font-bold uppercase bg-rose-950 text-rose-300 border border-rose-800 rounded">
          Sold Out
        </span>
      {% endif %}
    </a>

    {% comment %} Product Vendor & Title {% endcomment %}
    {% if product.vendor != blank %}
      <span class="text-[11px] uppercase tracking-wider text-accent font-bold block mb-1">
        {{ product.vendor }}
      </span>
    {% endif %}

    <h3 class="text-sm font-bold text-foreground line-clamp-2 leading-snug">
      <a href="{{ product.url }}" class="hover:text-accent transition-colors">
        {{ product.title }}
      </a>
    </h3>

    {% comment %} Technical Spec Badges (Metafield Integration) {% endcomment %}
    <div class="mt-3 flex flex-wrap gap-1.5">
      <span class="inline-block text-[10px] px-2 py-0.5 bg-background border border-border rounded text-muted">
        {{ product.metafields.electronics.battery_life.value | default: '40h Battery' }}
      </span>
      <span class="inline-block text-[10px] px-2 py-0.5 bg-background border border-border rounded text-muted">
        {{ product.metafields.electronics.connectivity.value | default: 'Bluetooth 5.3' }}
      </span>
    </div>
  </div>

  {% comment %} Price & Action Buttons {% endcomment %}
  <div class="mt-4 pt-3 border-t border-border flex items-center justify-between">
    <div>
      <span class="text-base font-bold text-accent">
        {{ product.price | money }}
      </span>
      {% if product.compare_at_price > product.price %}
        <span class="text-xs line-through text-muted ml-1">
          {{ product.compare_at_price | money }}
        </span>
      {% endif %}
    </div>

    <div class="flex items-center gap-1.5">
      <button
        type="button"
        class="p-2 bg-background hover:bg-slate-800 border border-border rounded-button text-muted hover:text-accent transition-colors"
        title="Add to Compare"
        onclick="TechGearCompare && TechGearCompare.toggle({ id: '{{ product.id }}', title: '{{ product.title | escape }}', price: '{{ product.price | money }}', image: '{{ product.featured_image | image_url: width: 300 }}', url: '{{ product.url }}', battery: '{{ product.metafields.electronics.battery_life.value | default: "40h Battery" }}', connectivity: '{{ product.metafields.electronics.connectivity.value | default: "Bluetooth 5.3" }}', anc: 'Yes' })"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
        </svg>
      </button>

      <a
        href="{{ product.url }}"
        class="px-3 py-1.5 bg-accent hover:bg-blue-500 text-white rounded-button text-xs font-bold transition-colors"
      >
        View
      </a>
    </div>
  </div>
</div>
