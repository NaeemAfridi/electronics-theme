{% doc %}
  Renders the slide-out product technical spec comparison drawer.

  @example
  {% render 'spec-comparison-drawer' %}
{% enddoc %}

<div
  id="SpecComparisonDrawer"
  class="fixed inset-0 z-50 hidden flex justify-end bg-slate-950/80 backdrop-blur-sm transition-opacity duration-300"
  role="dialog"
  aria-modal="true"
  aria-labelledby="SpecComparisonTitle"
>
  <div class="w-full max-w-4xl h-full bg-slate-900 border-l border-slate-800 flex flex-col shadow-2xl overflow-hidden">
    
    {% comment %} Drawer Header {% endcomment %}
    <div class="p-6 border-b border-slate-800 flex items-center justify-between bg-slate-950">
      <div>
        <h3 id="SpecComparisonTitle" class="text-xl font-bold text-slate-100 flex items-center gap-2">
          <svg class="w-5 h-5 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
          </svg>
          Technical Spec Comparison
        </h3>
        <p class="text-xs text-slate-400 mt-1">Compare hardware specifications side-by-side</p>
      </div>

      <button
        type="button"
        id="CloseSpecComparisonBtn"
        class="p-2 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 transition-colors focus:outline-none"
        aria-label="Close comparison drawer"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    {% comment %} Comparison Grid Container {% endcomment %}
    <div class="flex-1 overflow-y-auto p-6">
      <div id="SpecComparisonMatrix" class="grid grid-cols-1 md:grid-cols-3 gap-6">
        
        {% comment %} Empty State Fallback {% endcomment %}
        <div class="col-span-full py-16 text-center text-slate-400">
          <svg class="w-12 h-12 mx-auto mb-4 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
          </svg>
          <p class="text-base font-semibold text-slate-200">No products added for comparison yet.</p>
          <p class="text-xs text-slate-500 mt-1">Click "Add to Compare" on any product page to compare hardware specs side-by-side.</p>
        </div>

      </div>
    </div>

    {% comment %} Drawer Footer Actions {% endcomment %}
    <div class="p-4 border-t border-slate-800 bg-slate-950 flex items-center justify-between">
      <button
        type="button"
        id="ClearSpecComparisonBtn"
        class="text-xs text-slate-400 hover:text-red-400 transition-colors"
      >
        Clear all items
      </button>
      
      <span class="text-xs text-slate-500">Up to 3 products allowed</span>
    </div>

  </div>
</div>
